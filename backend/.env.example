# Copy to .env before composer install. Local development only.
APP_ENV=dev
APP_DEBUG=1
# Generate your own value: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_SECRET=replace-with-a-generated-local-value
DEFAULT_URI=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Contact form submissions won't send email with this setting.
MAILER_DSN=null://null
MAILER_FROM=dev@example.test
CONTACT_EMAIL=contact@example.test
